{
  "name": "genai-trace-explorer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "forwardPorts": [4318],
  "portsAttributes": {
    "4318": {
      "label": "Trace viewer (/), OTLP/HTTP (/v1/traces), API docs (/docs)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -e \".[dev]\"",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
