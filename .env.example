# SQLite file by default; postgres:// and postgresql:// URLs are accepted as well
DATABASE_URL=sqlite:///./traces.db
# Require "Authorization: Bearer <token>" on POST /v1/traces (OTEL_EXPORTER_OTLP_HEADERS on the client)
INGEST_TOKEN=
# Require "Authorization: Bearer <token>" on the /api query endpoints (the viewer asks for it)
READ_TOKEN=
# Keep prompts, completions and tool arguments (dropped at ingest by default)
CAPTURE_CONTENT=false
# Mask emails, phone numbers and card numbers in stored attributes
REDACT_PII=true
# Your own price table (USD per 1M tokens); the bundled example table when empty
PRICING_FILE=
MAX_BODY_BYTES=5000000
RETENTION_DAYS=14
LOG_LEVEL=INFO
